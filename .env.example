# Supabase / Payload PostgreSQL (connection string lives in .env)
DATABASE_URL=
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudinary Media API credentials (server-side only; never prefix these with NEXT_PUBLIC_)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sdn3-way-galih
# Cloud name is public and used only for constructing image CDN URLs in the frontend
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Optional for Supabase/S3-compatible legacy fallback
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=
S3_PUBLIC_URL=

# Optional tuning for Supabase session pooler
DATABASE_POOL_MAX=5
